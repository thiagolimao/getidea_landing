{
  "env": {
    "browser": true,
    "node": true,
    "es6": true
  },
  "extends": ["eslint:recommended"],
  "parserOptions": {
    "ecmaVersion": 2020,
    "sourceType": "module"
  },
  "globals": {
    "gsap": "readonly",
    "ScrollTrigger": "readonly",
    "Swiper": "readonly",
    "removeOpened": "writable"
  },
  "rules": {
    "no-unused-vars": [
      "warn",
      {
        "vars": "local",
        "args": "none",
        "varsIgnorePattern": "^_"
      }
    ],
    "prefer-const": "error",
    "semi": ["error", "always"],
    "quotes": ["error", "double"],
    "indent": ["error", 2]
  }
}
